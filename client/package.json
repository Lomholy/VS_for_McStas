{
  "name": "vs-for-mcstas",
  "displayName": "VS_for_McStas",
  "description": "VS_for_McStas is an extension that aims to deliver McStas syntax highlighting, as well as GUI component insertion.",
  "version": "1.2.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lomholy/VS_for_McStas"
  },
  "publisher": "lomholy",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage"],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {}
  }, 
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  }
}
